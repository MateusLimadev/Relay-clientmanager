# URL do Web App do Apps Script (Deploy > Nova implantação > Aplicativo da Web),
# termina em /exec
SHEETS_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Mesmo valor colocado na Script Property API_TOKEN do projeto Apps Script.
# Gere algo aleatório, ex: openssl rand -hex 32
SHEETS_API_TOKEN=

# Senha única de acesso ao painel
ADMIN_PASSWORD=

# Chave usada para assinar o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=
