# Connection string do Supabase (Project Settings > Database > Connection
# string > "Transaction pooler", porta 6543 — funciona igual em dev e em
# produção serverless na Vercel).
DATABASE_URL=postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Senha única de acesso ao painel
ADMIN_PASSWORD=

# Chave usada para assinar o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=

# --- Cobrança automática por WhatsApp (opcional — deixe em branco enquanto
# não for ativar; o interruptor em /configuracoes fica desligado por padrão) ---

# Segredo que a Vercel manda no header Authorization do cron. Gere com:
# openssl rand -base64 32 (e cole o mesmo valor nas configs do projeto na
# Vercel — ela usa CRON_SECRET automaticamente nos jobs de vercel.json).
CRON_SECRET=

# Segredo embutido na URL do webhook do Banco Inter
# (/api/webhooks/bancointer/SEU_SEGREDO). Gere com: openssl rand -base64 32
BANCOINTER_WEBHOOK_SECRET=

# Credenciais da API do Banco Inter (Conta Digital > API > gerar credenciais).
BANCOINTER_CLIENT_ID=
BANCOINTER_CLIENT_SECRET=
# Chave Pix cadastrada na conta Inter que vai receber as cobranças.
BANCOINTER_PIX_KEY=
# Certificado e chave privada do mTLS gerados no painel do Inter, cada um
# convertido pra base64 numa linha só: base64 -w0 Inter_API_Certificado.crt
BANCOINTER_CERT=
BANCOINTER_KEY=

# Credenciais do WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nome do template aprovado pela Meta usado na cobrança (padrão: cobranca_vencimento)
WHATSAPP_TEMPLATE_NAME=
